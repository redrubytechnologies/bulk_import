<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Update Sale Order sequence to use fiscal year suffix -->
        <record id="sale.seq_sale_order" model="ir.sequence">
            <field name="suffix">/%(fiscal_year)s</field>
            <field name="use_date_range">True</field>
        </record>

        <!-- Update Purchase Order sequence to use fiscal year suffix -->
        <record id="purchase.seq_purchase_order" model="ir.sequence">
            <field name="suffix">/%(fiscal_year)s</field>
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>
