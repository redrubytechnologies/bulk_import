<templates xml:space="preserve">
    <t t-name="zigma_erp.CustomMovesListRenderer.RecordRow" t-inherit-mode="primary" t-inherit="web.ListRenderer.RecordRow">
        <xpath expr="//tr/t[1]" position="inside">
            <t t-if="column.type === 'opendetailsop'">
                <td class="o_data_cell cursor-pointer o_list_button">
                    <t t-if="record.resModel === 'internal.transfer.outward.line' ">
                        <button name="Open Outward" class="btn btn-link fa fa-list" t-on-click="() => props.openRecord(record)"/>
                    </t>
                </td>
            </t>
            <t t-if="column.type === 'opendetailsin'">
                <td class="o_data_cell cursor-pointer o_list_button">
                    <t t-if="record.resModel === 'internal.transfer.inward.line' ">
                        <button name="Open Inward" class="btn btn-link fa fa-list" t-on-click="() => props.openRecord(record)"/>
                    </t>
                </td>
            </t>
        </xpath>
    </t>

    <t t-name="stock.TraceabilityReport" t-inherit="stock.TraceabilityReport" t-inherit-mode="extension">
        <xpath expr="//th[normalize-space()='Quantity']" position="after">
            <th class="o_report_line_header">Vendor/Customer</th>
        </xpath>
    </t>

</templates>
