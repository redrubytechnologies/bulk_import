        <!-- </record> -->
<record id="stock_picking_label_paperformat" model="report.paperformat">
        <field name="name">Stock Picking Label Format</field>
        <field name="format">custom</field>
        <field name="page_height">150</field>
        <field name="page_width">100</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="orientation">Portrait</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
  
    <!-- Report Definition -->
    <record id="action_report_stock_picking_label" model="ir.actions.report">
        <field name="name">Stock Picking Label</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zigma_erp.stock_picking_label_template</field>
        <field name="report_file">zigma_erp.stock_picking_label_template</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="stock_picking_label_paperformat"/>
    </record>

    <record id="stock_picking_label_paperformat" model="report.paperformat">
    <field name="name">Stock Picking Label Format</field>
    <field name="format">custom</field>
    <field name="page_height">63</field>  <!-- 6.3cm = 63mm -->
    <field name="page_width">95</field>   <!-- 9.5cm = 95mm -->
    <field name="margin_top">2</field>    <!-- Reduced margins for small label -->
    <field name="margin_bottom">2</field>
    <field name="margin_left">2</field>
    <field name="margin_right">2</field>
    <field name="orientation">Portrait</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">90</field>
</record>
 <template id="stock_picking_label_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <!-- Create one label per item line -->
            <t t-foreach="o.item_line_ids" t-as="item_line">
                <div style="border:1px solid black; font-size:11px; padding:2px; page-break-after: always; width:100%; height:100%; ">
                    <table width="100%" style="border-collapse: collapse;">
                        <tr>
                            <td style="width:20%; vertical-align: top; border-right:1px solid black;">
                                <img t-if="o.company_id.logo"
                                     t-att-src="image_data_uri(o.company_id.logo)"
                                     style="height: 80px; width: 80px;" />
                            </td>
                            <td style="padding-left: 5px; font-size: 10px;">
                                <strong>THE ZIGMA TECHNOLOGIES INDIA (P) LIMITED</strong><br/>
                                Vaidi Logi Tech Park, SIDCO Industrial Estate,<br/>
                                Thirumazhisai, Poonamallee, Tiruvallur, Chennai<br/>
                                Tamil Nadu - 600124. GSTIN: 33AACCT0611K1ZQ<br/>
                                Customer Care : 9791933074/80/83,<br/>
                                support@zigmaindia.com
                            </td>
                        </tr>
                        
                        <tr>
                            <td colspan="2" style="border-top:1px solid black; border-bottom:1px solid black; font-size: 10px;">
                                <table width="100%">
                                    <tr>
                                        <td style="font-size: 10px;"><strong>Ref:</strong> <span t-esc="o.dc_number or o.name"/></td>
                                        <td style="text-align:right; font-size: 10px;">
                                            <strong>Pcs:</strong> 
                                            <span t-esc="item_line_index + 1"/>/<span t-esc="len(o.item_line_ids)"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        
                        <tr>
                            <td colspan="2" style="padding-top: 5px;font-size: 10px;">
                                <strong>To,</strong><br/>
                                
                                <t t-if="o.partner_id.name">
                                    <strong t-esc="o.partner_id.name"/><br/>
                                </t>
                                
                                <t t-if="o.partner_id.street">
                                    <span t-esc="o.partner_id.street"/><br/>
                                </t>
                                <t t-if="o.partner_id.street2">
                                    <span t-esc="o.partner_id.street2"/><br/>
                                </t>
                                
                                <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip">
                                    <strong>
                                        <t t-if="o.partner_id.city">
                                            <span t-esc="o.partner_id.city"/>
                                        </t>
                                        <t t-if="o.partner_id.state_id">
                                            <span t-esc="o.partner_id.state_id.name"/>
                                        </t>
                                        <t t-if="o.partner_id.zip">
                                            <span t-esc="o.partner_id.zip"/>
                                        </t>
                                    </strong><br/>
                                </t>
                                
                                <t t-if="o.partner_id.country_id">
                                    <strong t-esc="o.partner_id.country_id.name"/><br/>
                                </t>
                                
                                <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                    <t t-if="o.partner_id.phone">
                                        <span t-esc="o.partner_id.phone"/>
                                    </t>
                                    <t t-if="o.partner_id.mobile">
                                        <t t-if="o.partner_id.phone">, </t>
                                        <span t-esc="o.partner_id.mobile"/>
                                    </t>
                                    <br/>
                                </t>
                                
                                <t t-if="o.partner_id.email">
                                    <span t-esc="o.partner_id.email"/><br/>
                                </t>
                                
                                <t t-if="o.partner_id.vat">
                                    <span t-esc="o.partner_id.vat"/><br/>
                                </t>
                                
                                
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </t>
</template>
